@page "/ingredients"
@using System.Globalization
@attribute [StreamRendering]

@inject HttpClient Http

<h1>Ingredients</h1>

@if (ingredients == null || ingredients.Count == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Serving size (g)</th>
                <th>Iron amount (mg)</th>
                <th>Percentage daily value (%)</th>
                <th>Is Vegetarian</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var ingredient in ingredients)
        {
            <tr>
                <td>
                    <input type="checkbox"
                           @bind="ingredient.IsSelected" />
                </td>
                <td>@ingredient.Name</td>
                <td>@ingredient.Serving</td>
                <td>@ingredient.AmountMg</td>
                <td>@ingredient.PercentageDV</td>
                <td>@(ingredient.IsVegetarian ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>

    <h3>Selected ingredients</h3>
    <ul>
        @foreach (var ing in SelectedIngredients)
        {
            <li>@ing.Name (@ing.AmountMg mg)</li>
        }
    </ul>
}

@code {
    private List<Ingredient> ingredients = new();

    // Separate object holding selected ingredients
    public List<Ingredient> SelectedIngredients =>  ingredients.Where(i => i.IsSelected).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCsv();
    }

    private async Task LoadCsv()
    {
        using var stream = await Http.GetStreamAsync("data/top_200_iron_cleaned.csv");
        using var reader = new StreamReader(stream);

        string? line;
        bool skipHeader = true;

        while ((line = await reader.ReadLineAsync()) != null)
        {
            if (skipHeader) { skipHeader = false; continue; }

            var columns = SplitCsvLine(line);

            // Erwartet: Name, Serving, AmountMg, PercentageDV, IsVegetarian
            if (columns.Length < 5)
                continue;

            ingredients.Add(new Ingredient
            {
                Name = CleanName(columns[1]),
                Serving = ParseFloat(columns[2]),
                AmountMg = ParseFloat(columns[3]),
                PercentageDV = ParseFloat(columns[4]),
                IsVegetarian = false,
                IsSelected = false
            });
        }
    }

    private string[] SplitCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        string current = "";

        foreach (char c in line)
        {
            if (c == '\"')
            {
                inQuotes = !inQuotes;
                continue;
            }

            if (c == ',' && !inQuotes)
            {
                result.Add(current);
                current = "";
            }
            else
            {
                current += c;
            }
        }

        result.Add(current);
        return result.ToArray();
    }

    private float ParseFloat(string raw)
    {
        var cleaned = new string(raw.Where(c => char.IsDigit(c) || c == '.' || c == '-').ToArray());
        float.TryParse(cleaned, NumberStyles.Any, CultureInfo.InvariantCulture, out float value);
        return value;
    }

    private string CleanName(string input)
    {
        input = input.Trim();

        if (input.StartsWith("\"") && input.EndsWith("\""))
            input = input[1..^1];

        input = input.Replace(",", " ");

        return input.Trim();
    }

    public class Ingredient
    {
        public string? Name { get; set; }
        public float Serving { get; set; }
        public float AmountMg { get; set; }
        public float PercentageDV { get; set; }
        public bool IsVegetarian { get; set; }

        // Checkbox state
        public bool IsSelected { get; set; }
    }
}
